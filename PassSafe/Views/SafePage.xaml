<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PassSafe.Views.SafePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:PassSafe.Converters" xmlns:loc="clr-namespace:PassSafe.Helpers" xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons" xmlns:models="clr-namespace:PassSafe.Models" xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" xmlns:vm="clr-namespace:PassSafe.ViewModels"
             x:Name="RootPage"
             Title="{Binding Loc[TabSafe]}"
             x:DataType="vm:SafeViewModel"
             BindingContext="{Binding SafeViewModel, Source={StaticResource VMLocator}}">

    <ContentPage.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="WidthRequest" Value="36" />
            <Setter Property="HeightRequest" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#20FFFFFF" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="CategoryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="15,5" />
        </Style>

        <converters:StringToIconConverter x:Key="StringToIconConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, *">

        <Grid Grid.Row="0"
              Margin="15,15,15,0"
              ColumnDefinitions="*, Auto">

            <ScrollView Grid.Column="0"
                        HorizontalScrollBarVisibility="Never" Orientation="Horizontal" VerticalScrollBarVisibility="Never">

                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Categories}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryItem">
                            <Button Command="{Binding BindingContext.SelectCategoryCommand, Source={x:Reference RootPage}}"
                                    CommandParameter="{Binding .}"
                                    Style="{StaticResource CategoryButton}"
                                    Text="{Binding Name}">
                                <Button.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}"
                                                 TargetType="Button"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="#ff3040" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>

            </ScrollView>

            <Button Grid.Column="1"
                    Margin="10,0,0,0" Padding="0"
                    mi:MauiIcon.Value="{mi:MaterialSharp Icon=Add,
                                                         IconColor=White}"
                    BackgroundColor="{DynamicResource Primary}"
                    Command="{Binding ShowAddPasswordPopupCommand}"
                    CornerRadius="12" HeightRequest="40" HorizontalOptions="End" VerticalOptions="Center" WidthRequest="40" />
        </Grid>

        <SearchBar Grid.Row="1"
                   Margin="15,10,15,0"
                   BackgroundColor="Transparent"
                   CancelButtonColor="{DynamicResource Primary}"
                   Placeholder="{Binding Loc[SearchPlaceholder]}"
                   PlaceholderColor="Gray"
                   Text="{Binding SearchQuery}"
                   TextColor="{AppThemeBinding Dark=White,
                                               Light=Black}"
                   VerticalOptions="Center" />

        <RefreshView Grid.Row="2"
                     Command="{Binding LoadPasswordsCommand}"
                     IsRefreshing="{Binding IsRefreshing}">

            <ScrollView VerticalScrollBarVisibility="Default">

                <VerticalStackLayout Margin="15,10,15,20"
                                     BindableLayout.ItemsSource="{Binding CollectionViewItemSource}"
                                     Spacing="10">

                    <BindableLayout.EmptyView>
                        <DataTemplate x:DataType="{x:Null}">
                            <Label Margin="0,50,0,0"
                                   HorizontalOptions="Center"
                                   Text="{Binding BindingContext.DbStatus, Source={x:Reference RootPage}}"
                                   VerticalOptions="Center" />
                        </DataTemplate>
                    </BindableLayout.EmptyView>

                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Password">
                            <SwipeView>

                                <SwipeView.LeftItems>
                                    <SwipeItems Mode="Reveal">
                                        <SwipeItemView Command="{Binding BindingContext.SetFavoritePasswordCommand, Source={x:Reference RootPage}}" CommandParameter="{Binding .}">
                                            <Border Margin="0,0,8,0"
                                                    HorizontalOptions="Fill" StrokeShape="RoundRectangle 12" StrokeThickness="0" VerticalOptions="Fill" WidthRequest="75">
                                                <Border.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorited}"
                                                                 TargetType="Border"
                                                                 Value="False">
                                                        <Setter Property="BackgroundColor" Value="#333333" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsFavorited}"
                                                                 TargetType="Border"
                                                                 Value="True">
                                                        <Setter Property="BackgroundColor" Value="#FF3040" />
                                                    </DataTrigger>
                                                </Border.Triggers>

                                                <VerticalStackLayout HorizontalOptions="Center" Spacing="3" VerticalOptions="Center">
                                                    <Image HorizontalOptions="Center">
                                                        <Image.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorited}"
                                                                         TargetType="Image"
                                                                         Value="False">
                                                                <Setter Property="mi:MauiIcon.Value" Value="{mi:MaterialSharp Icon=FavoriteBorder, IconColor=White, IconSize=22}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsFavorited}"
                                                                         TargetType="Image"
                                                                         Value="True">
                                                                <Setter Property="mi:MauiIcon.Value" Value="{mi:MaterialSharp Icon=Favorite, IconColor=White, IconSize=22}" />
                                                            </DataTrigger>
                                                        </Image.Triggers>
                                                    </Image>
                                                </VerticalStackLayout>
                                            </Border>
                                        </SwipeItemView>
                                    </SwipeItems>
                                </SwipeView.LeftItems>

                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                                        <SwipeItemView Command="{Binding BindingContext.DeletePasswordCommand, Source={x:Reference RootPage}}" CommandParameter="{Binding .}">
                                            <Border Margin="8,0,0,0"
                                                    BackgroundColor="#D32F2F" HorizontalOptions="Fill" StrokeShape="RoundRectangle 12" StrokeThickness="0" VerticalOptions="Fill" WidthRequest="75">
                                                <VerticalStackLayout HorizontalOptions="Center" Spacing="3" VerticalOptions="Center">
                                                    <Image mi:MauiIcon.Value="{mi:MaterialSharp Icon=Delete, IconColor=White, IconSize=22}" HorizontalOptions="Center" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </SwipeItemView>
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Border Padding="12,8"
                                        BackgroundColor="#222222" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                        <Border Grid.Column="0"
                                                BackgroundColor="#181830" HeightRequest="44" InputTransparent="True" StrokeShape="RoundRectangle 12" StrokeThickness="0" VerticalOptions="Center" WidthRequest="44">
                                            <Image mi:MauiIcon.Value="{mi:MaterialSharp Icon={Binding Icon,
                                                                                                      Converter={StaticResource StringToIconConverter}},
                                                                                        IconColor=White,
                                                                                        IconSize=24}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1"
                                                             InputTransparent="True" Spacing="2" VerticalOptions="Center">

                                            <Label FontAttributes="Bold" FontSize="14"
                                                   Text="{Binding Title}"
                                                   TextColor="White" />
                                            <Label FontSize="12"
                                                   Text="{Binding UserName}"
                                                   TextColor="#8E8E93" />
                                            <Label FontAttributes="Bold" FontSize="13"
                                                   Text="{Binding DisplayPassword}"
                                                   TextColor="{DynamicResource Primary}" />

                                            <HorizontalStackLayout Spacing="5">
                                                <HorizontalStackLayout.IsVisible>
                                                    <OnIdiom x:TypeArguments="x:Boolean" Default="False" Desktop="True" />
                                                </HorizontalStackLayout.IsVisible>
                                                <ProgressBar Progress="{Binding SecurityProgress}" WidthRequest="70" />
                                                <Label FontSize="11" Text="{Binding SecurityStatus}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <HorizontalStackLayout Grid.Column="2"
                                                               Spacing="4" VerticalOptions="Center">

                                            <Button Command="{Binding BindingContext.SetFavoritePasswordCommand, Source={x:Reference RootPage}}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource IconButton}"
                                                    ToolTipProperties.Text="{Binding Loc[TooltipFavorite]}">
                                                <Button.IsVisible>
                                                    <OnIdiom x:TypeArguments="x:Boolean" Default="False" Desktop="True" />
                                                </Button.IsVisible>
                                                <Button.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorited}"
                                                                 TargetType="Button"
                                                                 Value="False">
                                                        <Setter Property="mi:MauiIcon.Value" Value="{mi:MaterialSharp Icon=FavoriteBorder, IconColor=#8E8E93, IconSize=20}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsFavorited}"
                                                                 TargetType="Button"
                                                                 Value="True">
                                                        <Setter Property="mi:MauiIcon.Value" Value="{mi:MaterialSharp Icon=Favorite, IconColor=#ff3040, IconSize=20}" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>

                                            <Button Command="{Binding BindingContext.ShowPasswordCommand, Source={x:Reference RootPage}}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource IconButton}"
                                                    ToolTipProperties.Text="{Binding Loc[TooltipVisibility]}">
                                                <Button.Triggers>
                                                    <DataTrigger Binding="{Binding IsPasswordVisible}"
                                                                 TargetType="Button"
                                                                 Value="False">
                                                        <Setter Property="mi:MauiIcon.Value" Value="{mi:MaterialSharp Icon=Visibility, IconColor=#8E8E93, IconSize=20}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPasswordVisible}"
                                                                 TargetType="Button"
                                                                 Value="True">
                                                        <Setter Property="mi:MauiIcon.Value" Value="{mi:MaterialSharp Icon=VisibilityOff, IconColor={StaticResource Primary}, IconSize=20}" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>

                                            <Button mi:MauiIcon.Value="{mi:MaterialSharp Icon=ContentCopy,
                                                                                         IconColor=#8E8E93,
                                                                                         IconSize=20}"
                                                    Command="{Binding BindingContext.CopyPasswordCommand, Source={x:Reference RootPage}}"
                                                    CommandParameter="{Binding EncryptedPassword}"
                                                    Style="{StaticResource IconButton}"
                                                    ToolTipProperties.Text="{Binding Loc[TooltipCopy]}" />

                                            <Button mi:MauiIcon.Value="{mi:MaterialSharp Icon=Edit,
                                                                                         IconColor=#8E8E93,
                                                                                         IconSize=20}"
                                                    Command="{Binding BindingContext.EditPasswordCommand, Source={x:Reference RootPage}}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource IconButton}"
                                                    ToolTipProperties.Text="{Binding Loc[TooltipEdit]}" />

                                            <Button mi:MauiIcon.Value="{mi:MaterialSharp Icon=Delete,
                                                                                         IconColor=#ff3040,
                                                                                         IconSize=20}"
                                                    Command="{Binding BindingContext.DeletePasswordCommand, Source={x:Reference RootPage}}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource IconButton}"
                                                    ToolTipProperties.Text="{Binding Loc[TooltipDelete]}">
                                                <Button.IsVisible>
                                                    <OnIdiom x:TypeArguments="x:Boolean" Default="False" Desktop="True" />
                                                </Button.IsVisible>
                                            </Button>

                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>