<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PassSafe.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PassSafe.Helpers" xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons" xmlns:viewmodels="clr-namespace:PassSafe.ViewModels"
             Title="{Binding Loc[SettingsTitle]}"
             x:DataType="viewmodels:SettingsViewModel"
             BindingContext="{Binding SettingsViewModel, Source={StaticResource VMLocator}}">

    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="{AppThemeBinding Dark=#E2E8F0, Light=#1e293b}" />
        </Style>
        <Style TargetType="Picker">
            <Setter Property="TextColor" Value="{DynamicResource Primary}" />
            <Setter Property="TitleColor" Value="Gray" />
        </Style>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{DynamicResource SystemBackground}" />
            <Setter Property="Stroke" Value="{DynamicResource Primary}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Margin="15,10,15,30" Spacing="25">

            <Label FontAttributes="Bold" FontSize="28"
                   Text="{Binding Loc[SettingsTitle]}" />

            <VerticalStackLayout Spacing="8">
                <Label Margin="5,0,0,0"
                       FontAttributes="Bold" FontSize="12"
                       Text="{Binding Loc[SecuritySection]}"
                       TextColor="Gray" />
                <VerticalStackLayout Spacing="10">

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <mi:MauiIcon Grid.Column="0"
                                         Margin="0,0,15,0"
                                         Icon="{mi:MaterialSharp Icon=Password}"
                                         IconColor="{DynamicResource Primary}"
                                         IconSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label FontAttributes="Bold" FontSize="15"
                                       Text="{Binding Loc[ChangeMasterPassTitle]}" />
                                <Label FontSize="12"
                                       Text="{Binding Loc[ChangeMasterPassDesc]}"
                                       TextColor="Gray" />
                            </VerticalStackLayout>
                            <mi:MauiIcon Grid.Column="2"
                                         Icon="{mi:MaterialSharp Icon=ChevronRight}"
                                         IconColor="{DynamicResource Primary}"
                                         IconSize="24" VerticalOptions="Center" />
                        </Grid>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangeMasterPasswordCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <mi:MauiIcon Grid.Column="0"
                                         Margin="0,0,15,0"
                                         Icon="{mi:MaterialSharp Icon=Timer}"
                                         IconColor="{DynamicResource Primary}"
                                         IconSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label FontAttributes="Bold" FontSize="15"
                                       Text="{Binding Loc[AutoLockTitle]}" />
                                <Label FontSize="12"
                                       Text="{Binding Loc[AutoLockDesc]}"
                                       TextColor="Gray" />
                            </VerticalStackLayout>
                            <Picker Grid.Column="2"
                                    HorizontalOptions="End"
                                    ItemDisplayBinding="{Binding Name}"
                                    ItemsSource="{Binding AutoLockOptions}"
                                    SelectedItem="{Binding SelectedAutoLockTime}"
                                    VerticalOptions="Center" WidthRequest="120" />
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Margin="5,0,0,0"
                       FontAttributes="Bold" FontSize="12"
                       Text="{Binding Loc[AppearanceSection]}"
                       TextColor="Gray" />
                <VerticalStackLayout Spacing="10">

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <mi:MauiIcon Grid.Column="0"
                                         Margin="0,0,15,0"
                                         Icon="{mi:MaterialSharp Icon=Palette}"
                                         IconColor="{DynamicResource Primary}"
                                         IconSize="24" VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   FontAttributes="Bold" FontSize="15"
                                   Text="{Binding Loc[AccentColorTitle]}"
                                   VerticalOptions="Center" />
                            <Picker Grid.Column="2"
                                    HorizontalOptions="End"
                                    ItemDisplayBinding="{Binding Name}"
                                    ItemsSource="{Binding ColorOptions}"
                                    SelectedItem="{Binding SelectedAccentColor}"
                                    VerticalOptions="Center" WidthRequest="150" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <mi:MauiIcon Grid.Column="0"
                                         Margin="0,0,15,0"
                                         Icon="{mi:MaterialSharp Icon=DarkMode}"
                                         IconColor="{DynamicResource Primary}"
                                         IconSize="24" VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   FontAttributes="Bold" FontSize="15"
                                   Text="{Binding Loc[ThemeTitle]}"
                                   VerticalOptions="Center" />
                            <Picker Grid.Column="2"
                                    HorizontalOptions="End"
                                    ItemDisplayBinding="{Binding Name}"
                                    ItemsSource="{Binding ThemeOptions}"
                                    SelectedItem="{Binding SelectedTheme}"
                                    VerticalOptions="Center" WidthRequest="120" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <mi:MauiIcon Grid.Column="0"
                                         Margin="0,0,15,0"
                                         Icon="{mi:MaterialSharp Icon=Language}"
                                         IconColor="{DynamicResource Primary}"
                                         IconSize="24" VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   FontAttributes="Bold" FontSize="15"
                                   Text="{Binding Loc[LanguageTitle]}"
                                   VerticalOptions="Center" />
                            <Picker Grid.Column="2"
                                    HorizontalOptions="End"
                                    ItemDisplayBinding="{Binding Name}"
                                    ItemsSource="{Binding LanguageOptions}"
                                    SelectedItem="{Binding SelectedLanguage}"
                                    VerticalOptions="Center" WidthRequest="120" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Margin="5,0,0,0"
                       FontAttributes="Bold" FontSize="12"
                       Text="{Binding Loc[DataManagementSection]}"
                       TextColor="Gray" />
                <VerticalStackLayout Spacing="10">

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <mi:MauiIcon Grid.Column="0"
                                         Margin="0,0,15,0"
                                         Icon="{mi:MaterialSharp Icon=CloudUpload}"
                                         IconColor="{DynamicResource Primary}"
                                         IconSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label FontAttributes="Bold" FontSize="15"
                                       Text="{Binding Loc[ImportBackupTitle]}" />
                                <Label FontSize="12"
                                       Text="{Binding Loc[ImportBackupDesc]}"
                                       TextColor="Gray" />
                            </VerticalStackLayout>
                            <mi:MauiIcon Grid.Column="2"
                                         Icon="{mi:MaterialSharp Icon=ChevronRight}"
                                         IconColor="{DynamicResource Primary}"
                                         IconSize="24" VerticalOptions="Center" />
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ImportDatabaseCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <mi:MauiIcon Grid.Column="0"
                                         Margin="0,0,15,0"
                                         Icon="{mi:MaterialSharp Icon=CloudDownload}"
                                         IconColor="{DynamicResource Primary}"
                                         IconSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label FontAttributes="Bold" FontSize="15"
                                       Text="{Binding Loc[ExportDbTitle]}" />
                                <Label FontSize="12"
                                       Text="{Binding Loc[ExportDbDesc]}"
                                       TextColor="Gray" />
                            </VerticalStackLayout>
                            <mi:MauiIcon Grid.Column="2"
                                         Icon="{mi:MaterialSharp Icon=ChevronRight}"
                                         IconColor="{DynamicResource Primary}"
                                         IconSize="24" VerticalOptions="Center" />
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ExportDatabaseCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>